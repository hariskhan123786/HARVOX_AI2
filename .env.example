# ── HARVOX AI PRODUCTION ENVIRONMENT CONFIGURATION ────────────────────

# Server listening port
PORT=5000

# Environment state (development / production)
NODE_ENV=production

# MongoDB Database Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=

# Run database locally in-memory for offline testing or automated QA
# Options: true / false
USE_IN_MEMORY_DB=false

# JSON Web Token Auth Secret Key
# RECOMMENDATION: Generate a strong random key (e.g. openssl rand -base64 32)
JWT_SECRET=

# Groq Cloud AI API Token key
GROQ_API_KEY=

# Google Gemini API key
GEMINI_API_KEY=

# Client front-end Origin URL (for CORS checks)
# Production Example: https://harvox.ai
CLIENT_URL=http://localhost:5173

# Standard usage tier daily message credits
FREE_DAILY_LIMIT=20
PRO_DAILY_LIMIT=500
