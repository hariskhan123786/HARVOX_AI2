# ============================================================
# HARVOX AI — Environment Variables (Phase 14 — Supabase)
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to Git.

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
# Add these in Vercel Project Settings → Environment Variables for Production.
# Never expose SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin Seeding ─────────────────────────────────────────────
# Password for the seeded admin@harvox.ai account
ADMIN_PASSWORD=HarvoxAdmin2025!

# ── AI Providers ─────────────────────────────────────────────
# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=gsk_...

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=AIza...

# Cerebras (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=...

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-...

# OpenAI (https://platform.openai.com) — optional
OPENAI_API_KEY=sk-...

# HuggingFace (https://huggingface.co/settings/tokens) — optional
HUGGINGFACE_API_KEY=hf_...

# ── Whisper / Voice ───────────────────────────────────────────
# Used for transcribeSpeech — leave blank to use Groq Whisper
WHISPER_API_KEY=
