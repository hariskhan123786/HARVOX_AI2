# ── HARVOX AI — Backend-only Dockerfile for Railway ──────────────────────────
# Build context = REPO ROOT (Railway uses root by default)
# dockerfilePath = server/Dockerfile.railway → so all COPY paths are relative to root

FROM node:20-alpine AS builder

WORKDIR /app/server

# Install native build tools for node-pty
RUN apk add --no-cache python3 make g++ bash

# ✅ Copy from server/ inside the root build context
COPY server/package*.json ./

# Skip mongodb-memory-server binary download (not needed in production)
ENV MONGOMS_DISABLE_POSTINSTALL=1

RUN npm ci --omit=dev --silent || npm install --omit=dev --silent

# Copy all server source files
COPY server/ ./

# ── FINAL RUNNER ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app/server

# node-pty needs these at runtime too
RUN apk add --no-cache python3 make g++ bash

# Copy everything from builder
COPY --from=builder /app/server ./

ENV NODE_ENV=production
# PORT is injected by Railway at runtime — server.js reads process.env.PORT || 5000
ENV MONGOMS_DISABLE_POSTINSTALL=1

# Run as non-root
RUN chown -R node:node /app
USER node

CMD ["node", "server.js"]
