{
  "name": "harvox-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "cd server && npm start",
    "test": "cd server && node tests/testRunner.js"
  },
  "description": "HARVOX AI - Premium AI SaaS Platform",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@studio-freight/lenis": "^1.0.42",
    "@supabase/supabase-js": "^2.110.7",
    "@tsparticles/react": "^4.3.1",
    "@tsparticles/slim": "^4.3.1",
    "axios": "^1.16.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^1.2.0",
    "helmet": "^8.0.0",
    "mammoth": "^1.9.0",
    "mongodb": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.11",
    "pdf-parse": "^1.1.1",
    "react-tsparticles": "^2.12.2",
    "socket.io": "^4.8.3",
    "tsparticles": "^4.3.1",
    "tsparticles-slim": "^2.12.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
